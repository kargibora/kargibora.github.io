<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page.title | escape }}
      · NeurIPS 2026
    </title>
    <meta name="description" content="{{ page.description | escape }}">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page.title | escape }}">
    <meta property="og:description" content="{{ page.description | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ page.social_image | absolute_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ page.social_alt | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page.title | escape }}">
    <meta name="twitter:description" content="{{ page.description | escape }}">
    <meta name="twitter:image" content="{{ page.social_image | absolute_url }}">
    <meta name="twitter:image:alt" content="{{ page.social_alt | escape }}">
    <link rel="stylesheet" href="{{ '/assets/css/half-truths.css' | relative_url }}">
    {% if page.extra_css %}<link rel="stylesheet" href="{{ page.extra_css | relative_url }}">{% endif %}
    {% if page.paper_math %}
      <script src="{{ '/assets/al_math/js/mathjax-setup.js' | relative_url }}"></script>
      <script
        defer
        id="MathJax-script"
        src="{{ site.third_party_libraries.mathjax.url.js }}"
        integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
        crossorigin="anonymous"
      ></script>
    {% endif %}
    <script src="{{ '/assets/js/paper.js' | relative_url }}" defer></script>
    {% if page.extra_js %}<script src="{{ page.extra_js | relative_url }}" defer></script>{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <header class="project-hero container">
        {% if page.venue_above_title %}
          <p class="venue venue-badge">NeurIPS 2026 <span aria-hidden="true">·</span> Poster</p>
        {% endif %}
        <h1>{{ page.title }}</h1>
        <div class="publication-authors">{{ page.authors }}</div>
        <div class="publication-affiliations">{{ page.affiliations }}</div>
        {% if page.affiliation_logos %}
          <div class="affiliation-logos">
            {% for logo in page.affiliation_logos %}
              <img src="{{ logo.src | relative_url }}" alt="{{ logo.alt | escape }}" width="{{ logo.width }}" height="{{ logo.height }}">
            {% endfor %}
          </div>
        {% endif %}
        {% unless page.venue_above_title %}
          <p class="venue">NeurIPS 2026 · Poster</p>
        {% endunless %}
        <div class="publication-links">
          <a
            class="primary-link"
            href="{% if page.paper_url %}{{ page.paper_url | relative_url }}{% else %}https://arxiv.org/pdf/{{ page.arxiv }}{% endif %}"
          >
            {% if page.resource_icons %}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M14 2H5v20h14V7zM14 2v5h5M8 12h8M8 16h8"/>
              </svg>
            {% endif %}
            Paper</a
          ><a href="{{ page.code_url }}">
            {% if page.resource_icons %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 .297a12 12 0 0 0-3.793 23.384c.6.111.82-.261.82-.577 0-.285-.01-1.04-.016-2.041-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.769.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297"/>
              </svg>
            {% endif %}
            Code</a
          >
          {% if page.data_url %}
            <a href="{{ page.data_url }}">
              {% if page.resource_icons %}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                  focusable="false"
                >
                  <ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0"/>
                </svg>
              {% endif %}
              {{ page.data_label | default: 'Data' }}
            </a>
          {% endif %}
          {% if page.checkpoint_url %}
            <a href="{{ page.checkpoint_url }}">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/>
              </svg>
              Checkpoint
            </a>
          {% endif %}
          {% if page.training_data_url %}
            <a href="{{ page.training_data_url }}">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                focusable="false"
              >
                <ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0"/>
              </svg>
              Training Data
            </a>
          {% endif %}
          <a href="#citation">
            {% if page.resource_icons %}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M8 3H6v7l-3 2 3 2v7h2M16 3h2v7l3 2-3 2v7h-2"/>
              </svg>
            {% endif %}
            BibTeX</a
          >
        </div>
      </header>
      {{ content }}
      <section class="section" id="citation">
        <div class="container">
          <div class="citation-heading">
            <h2>Cite this work</h2>
            <button type="button" id="copy-citation" hidden>Copy citation</button>
          </div>
          <pre><code id="bibtex">{{ page.citation | escape }}</code></pre>
          <p id="copy-status" role="status"></p>
        </div>
      </section>
    </main>
    <footer class="container">
      <a href="{{ '/' | relative_url }}">Bora Kargi</a>
      <p>
        Research page adapted from
        <a href="https://github.com/eliahuhorwitz/Academic-project-page-template/tree/original-version">Academic Project Page</a> and
        <a href="https://nerfies.github.io/">Nerfies</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>
      </p>
    </footer>
  </body>
</html>
