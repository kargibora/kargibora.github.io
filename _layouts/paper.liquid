<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page.title | escape }}
      · NeurIPS 2026
    </title>
    <meta name="description" content="{{ page.description | escape }}">
    <meta name="theme-color" content="#f8f7f3">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page.title | escape }}">
    <meta property="og:description" content="{{ page.description | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ page.social_image | absolute_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ page.social_alt | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page.title | escape }}">
    <meta name="twitter:description" content="{{ page.description | escape }}">
    <meta name="twitter:image" content="{{ page.social_image | absolute_url }}">
    <meta name="twitter:image:alt" content="{{ page.social_alt | escape }}">
    <link rel="stylesheet" href="{{ '/assets/css/paper.css' | relative_url }}">
    <script src="{{ '/assets/js/paper.js' | relative_url }}" defer></script>
  </head>
  <body class="{{ page.paper_theme }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="{{ '/' | relative_url }}">Bora Kargi <span>/ Research</span></a>
      <a class="sibling-link" href="{{ page.related_url | relative_url }}">
        {{- page.related_name }}
        <span aria-hidden="true">↗</span></a
      >
    </header>
    <main id="main" class="wrap">
      <section class="hero" aria-labelledby="paper-title">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Accepted at NeurIPS 2026</p>
        <h1 id="paper-title">{{ page.short_title }}</h1>
        <p class="paper-subtitle">{{ page.subtitle }}</p>
        <p class="authors">{{ page.authors }}</p>
        <p class="affiliations">{{ page.affiliations }}</p>
        <nav class="resource-links" aria-label="Paper resources">
          <a class="button primary" href="https://arxiv.org/pdf/{{ page.arxiv }}">Read the paper <span aria-hidden="true">↗</span></a>
          <a class="button" href="{{ page.code_url }}">Code <span aria-hidden="true">↗</span></a>
          <a class="button" href="https://arxiv.org/abs/{{ page.arxiv }}">arXiv <span aria-hidden="true">↗</span></a>
          <a class="button" href="#citation">Cite this work <span aria-hidden="true">↓</span></a>
        </nav>
      </section>
      {{ content }}
      <section class="paper-section citation-section" id="citation" aria-labelledby="citation-title">
        <div class="section-heading">
          <p class="eyebrow">For your references</p>
          <h2 id="citation-title">Cite this work.</h2>
        </div>
        <div class="citation-box">
          <div class="citation-toolbar"><span>BibTeX</span><button type="button" id="copy-citation" hidden>Copy citation</button></div>
          <pre><code id="bibtex">{{ page.citation | escape }}</code></pre>
          <p id="copy-status" class="sr-only" role="status"></p>
        </div>
      </section>
      <aside class="related-paper">
        <div>
          <p class="eyebrow">More from our research</p>
          <a href="{{ page.related_url | relative_url }}">
            {{- page.related_name }}
            <span aria-hidden="true">↗</span></a
          >
        </div>
        <p>{{ page.related_description }}</p>
      </aside>
    </main>
    <footer class="site-footer wrap">
      <a href="{{ '/' | relative_url }}">Bora Kargi</a>
      <p>
        Layout inspired by <a href="https://nerfies.github.io/">Nerfies</a>. Figures by the paper authors (<a href="https://creativecommons.org/licenses/by/4.0/"
          >CC BY 4.0</a
        >).
      </p>
      <a href="#main">Back to top ↑</a>
    </footer>
  </body>
</html>
